# Copy values into your local environment / MCP server configuration.
# The application intentionally does not automatically read .env files.
SCHEMATIC_LLM_BASE_URL=https://api.openai.com/v1
SCHEMATIC_LLM_MODEL=YOUR_VISION_CAPABLE_MODEL
SCHEMATIC_LLM_API_KEY=
SCHEMATIC_LLM_RESPONSE_FORMAT=json_schema
SCHEMATIC_LLM_TOKEN_PARAMETER=max_completion_tokens
SCHEMATIC_LLM_MAX_TOKENS=16000
SCHEMATIC_LLM_TIMEOUT=120
SCHEMATIC_LLM_RETRIES=2
